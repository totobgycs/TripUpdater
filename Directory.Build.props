<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1515;CA1812;CA1056;CA2007;CA1031;CA1062;CA1822;CA1051;CA1054;CA1305;CA1310;CA1303;CA1304;CA1307;CA1308;CA1848;CA1862;CA2017;CA2016;CA2254;CA1055;CA1063;CA1716;CA1721;CA1724;CA1819;CA1845;CA2234;CA5350;CA5351;CA5368;CA5371;CA5387;CA5394;CA5395;CA5402;CA5403;CA5404;CA5405;CA1014;CA1308;CA1014;CA1000;CA1051;CA1707;NU1903;NU1902</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1903;NU1902;CA1014;CS1591</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
